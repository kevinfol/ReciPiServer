
div.navbar.bg-neutral.shadow-sm.gap-3.px-5
    div.grow-0.flex.flex-row.text-neutral-content.items-center.gap-0
        svg(width="24" height="24" viewBox="0 0 24 24")
            use(xlink:href="icons/pizza.svg")
        a.btn.btn-ghost.text-xl.text-neutral-content.pl-0.pr-1 ReciPi
    div.grow-1
        label.input.w-full
            svg(width="24" height="24" viewBox="0 0 24 24")
                use(xlink:href="icons/search.svg")
            input.grow#search-bar(type="text" placeholder="Search for recipes...")
    div.grow-0
        button.btn.btn-ghost.btn-circle.text-neutral-content
            svg(width="24" height="24" viewBox="0 0 24 24")
                use(xlink:href="icons/arrow-down-up.svg")
