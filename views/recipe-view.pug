extends layout.pug 
block recipe_list 
    div.grid.grid-cols-1.gap-3.p-3.flex-grow-1.auto-rows-min.overflow-scroll(class="sm:grid-cols-2 xs:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5")
        each recipe in recipes
            mixin recImg 
                if recipe.imageUrl
                    img.rounded-md.object-cover.aspect-video.shadow-md(src=recipe.imageUrl)
                else
                    svg.aspect-video.rounded-md.object-cover.ring-1.ring-base-300.shadow-md.bg-base-300(viewBox="0 0 24 24")
                        use(xlink:href="icons/camera-off.svg")

            div.flex.flex-col.gap-2.rounded-2xl.shadow.p-3.bg-base-100(data-key=recipe.key)
                div.line-clamp-1.font-semibold.text-xl #{recipe.name}
                div.flex.flex-row.justify-start.items-center.gap-2
                    svg(width="24" height="24" viewBox="0 0 24 24")
                        use(xlink:href="icons/code-xml.svg")
                    span.font-mono #{recipe.source}
                +recImg
                p.line-clamp-3.font-light.font-serif.h-18(class="text-lg/6") #{recipe.description}
                div.grid.grid-cols-2.gap-3
                    button.btn.flex.flex-col.justify-center.h-20.p-2(data-key=recipe.key)
                        svg(width="48" height="48" viewBox="0 0 24 24")
                            use(xlink:href="icons/book-open.svg")
                        p.font-bold.text-lg Open
                    button.btn.btn-neutral.flex.flex-col.justify-center.h-20.p-2(data-key=recipe.key)
                        svg(width="48" height="48" viewBox="0 0 24 24")
                            use(xlink:href="icons/file-x.svg")
                        p.font-bold.text-lg Delete
        include flower.pug
