//- layout.pug
html(data-theme="retro")
  head
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(http-equiv="x-ua-compatible" content="ie=edge")
    title #{title}
    link(rel='stylesheet' href='/stylesheets/style.css')
    block scripts
  body.bg-base-200.flex.flex-col.max-h-dvh.h-dvh
    include header-nav.pug
    block recipe_list
    footer.footer.bg-neutral.text-neutral-content.items-center.p-2.px-5.w-full(class="sm:footer-horizontal")
      div.flex.flex-row.items-center.w-full
        div.badge.badge-soft.badge-primary #{server_name}
        div.badge.badge-soft.badge-secondary #{num_recipes} Recipes
        div.badge.badge-soft.badge-accent.ml-auto Version #{version}